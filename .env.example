# ---- Скопируй в .env и заполни ----

# Postgres
POSTGRES_USER=zoombot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=zoombot
# URL, которым пользуется web-сервис (host = имя сервиса из docker-compose)
DATABASE_URL=postgresql+psycopg2://zoombot:change_me@db:5432/zoombot

# Redis (очередь задач / брокер планировщика)
REDIS_URL=redis://redis:6379/0

# ---- Zoom (этап 3, пока можно оставить пустым) ----
# Server-to-Server OAuth app из https://marketplace.zoom.us
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---- Тех-аккаунт бота для десктоп-клиента (этап 5) ----
ZOOM_BOT_EMAIL=
ZOOM_BOT_PASSWORD=

# Внутренний адрес API bot-worker (host = имя сервиса)
BOT_WORKER_URL=http://bot-worker:9000

# Секрет для служебных вызовов web ↔ bot-worker. ОБЯЗАТЕЛЕН: управляющий API
# bot-worker (порт 9000) закрыт, если токен пуст, а web шлёт его в заголовке
# X-Internal-Token. Оба сервиса берут одно и то же значение из этого .env.
INTERNAL_API_TOKEN=change_me_too
